# Supabase — crear proyecto en https://supabase.com y pegar aquí
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
# Opcional: site url para QR
NEXT_PUBLIC_BASE_URL=https://tu-app.onrender.com

# Nequi Negocios — QR dinámico (solo servidor, NUNCA exponer al cliente)
# Se obtienen en portal-b2b.nequi.com.co tras registro y certificación
NEQUI_API_KEY=
NEQUI_CLIENT_ID=
NEQUI_CLIENT_SECRET=
NEQUI_MERCHANT_CODE=
# development (sandbox) | production
NEQUI_ENV=development
# Poner en 1 para activar el QR Nequi con valor en /m/[mesaId] (requiere credenciales arriba)
NEXT_PUBLIC_NEQUI_DYNAMIC_QR=0
